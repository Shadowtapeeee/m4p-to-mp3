# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Пак премиум-эмодзи для лиц (t.me/addemoji/FaceEmoji)
EMOJI_PACK=FaceEmoji

# Путь к SQLite-базе
DB_PATH=./data/bot.db

# Сколько файлов конвертировать одновременно
MAX_CONCURRENT=2

# Лимит файла в МБ (публичный Bot API отдаёт файлы только до 20 МБ)
MAX_FILE_MB=20

# Таймаут ffmpeg в секундах
FFMPEG_TIMEOUT_SEC=600

# Свой Bot API сервер (telegram-bot-api --local) — снимает лимит 20 МБ до 2 ГБ
# BOT_API_ROOT=http://telegram-bot-api:8081
